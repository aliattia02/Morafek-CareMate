<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- ── Standard app permissions ──────────────────────────────────────── -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.RECORD_AUDIO"/>
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"/>

    <!-- ── Health Connect permissions ────────────────────────────────────── -->
    <!-- These <uses-permission> entries are required for Android to grant    -->
    <!-- access at the OS level. They are NOT sufficient on their own for    -->
    <!-- Health Connect v3.x — the <meta-data> + resource array below is    -->
    <!-- what makes the app appear in HC's "App permissions" list.           -->
    <uses-permission android:name="android.permission.health.READ_HEART_RATE"/>
    <uses-permission android:name="android.permission.health.READ_STEPS"/>
    <!-- WRITE_HEART_RATE and WRITE_STEPS removed: app is read-only, and Samsung's HC
         registration validator flags a mismatch when WRITE entries appear here but are
         absent from health_permissions.xml, causing "Needs updating" state. -->

    <!-- ── Package visibility: Health Connect ────────────────────────────── -->
    <!-- Required so the app can query whether HC is installed and open the  -->
    <!-- HC permission rationale screen.                                     -->
    <queries>
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <category android:name="android.intent.category.BROWSABLE"/>
            <data android:scheme="https"/>
        </intent>
        <intent>
            <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
        </intent>
        <!-- Legacy embedded HC (Android 12 and below) -->
        <package android:name="com.google.android.apps.healthdata"/>
        <!-- Standalone HC APK on Android 13 — THIS was missing and caused silent rejection -->
        <package android:name="com.google.android.healthconnect.controller"/>
    </queries>

    <application
        android:name=".MainApplication"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:allowBackup="true"
        android:theme="@style/AppTheme"
        android:supportsRtl="true"
        android:enableOnBackInvokedCallback="false"
        android:fullBackupContent="@xml/secure_store_backup_rules"
        android:dataExtractionRules="@xml/secure_store_data_extraction_rules">

        <!-- Expo Updates metadata -->
        <meta-data android:name="expo.modules.updates.ENABLED"                    android:value="true"/>
        <meta-data android:name="expo.modules.updates.EXPO_RUNTIME_VERSION"       android:value="@string/expo_runtime_version"/>
        <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
        <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS"  android:value="0"/>
        <meta-data android:name="expo.modules.updates.EXPO_UPDATE_URL"            android:value="https://u.expo.dev/85f11f8a-34e4-4d66-bfb5-b5edce06b2a6"/>

        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.App.SplashScreen"
            android:exported="true"
            android:screenOrientation="portrait">

            <!-- ── Health Connect v3.x app registration ───────────────────────── -->
            <!-- This metadata entry is REQUIRED for HC to discover this app and  -->
            <!-- display it in "App permissions". Without it requestPermission()  -->
            <!-- silently returns [] and no dialog is shown, regardless of the    -->
            <!-- <uses-permission> entries above.                                 -->
            <!-- The value points to res/values/health_permissions.xml.          -->
            <meta-data
                android:name="health_permissions"
                android:resource="@array/health_permissions"/>

            <!-- App entry point -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>

            <!-- Deep-link scheme for expo-router -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="Morafek"/>
            </intent-filter>

            <!-- Health Connect (Android 13): HC app checks for this intent-filter  -->
            <!-- before showing the permission dialog. Activity must be exported.   -->
            <intent-filter>
                <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
            </intent-filter>

        </activity>

        <!-- Health Connect (Android 14+): activity-alias required for the new     -->
        <!-- VIEW_PERMISSION_USAGE path used by platform HC on Android 14+.        -->
        <!-- Without this, HC's PermissionsActivity exits early on Android 14+,    -->
        <!-- including Samsung One UI 6+ devices even if they report Android 13.   -->
        <activity-alias
            android:name="ViewPermissionUsageActivity"
            android:exported="true"
            android:targetActivity=".MainActivity"
            android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
            <intent-filter>
                <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
                <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
            </intent-filter>
        </activity-alias>

    </application>

</manifest>