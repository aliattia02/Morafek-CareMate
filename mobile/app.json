{
  "expo": {
    "name": "Morafek",
    "slug": "Morafek",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "Morafek",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": false,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#8031A7"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morafek.mobile",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#8031A7"
      },
      "package": "com.morafek.mobile",
      "runtimeVersion": "1.0.0",
      "minSdkVersion": 26
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
"plugins": [
  "./plugins/withMinSdk",
  "expo-router",
  "expo-secure-store",
  "expo-asset",
  "expo-font",
  "expo-sqlite",
  "react-native-health-connect"
],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "85f11f8a-34e4-4d66-bfb5-b5edce06b2a6"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/85f11f8a-34e4-4d66-bfb5-b5edce06b2a6"
    }
  }
}