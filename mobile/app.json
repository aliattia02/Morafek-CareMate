{
  "expo": {
    "name": "Morafek",
    "slug": "Morafek",
    "version": "1.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "Morafek",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0E7C8B"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.morafek.mobile",
      "runtimeVersion": "1.0.3"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E7C8B"
      },
      "package": "com.morafek.mobile",
      "runtimeVersion": "1.0.3",
      "minSdkVersion": 26
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "./plugins/withMinSdk",
      "expo-router",
      "expo-secure-store",
      "expo-asset",
      "expo-font",
      "expo-sqlite",
      [
        "react-native-health-connect",
        {
          "permissions": [
            "HeartRate",
            "Steps"
          ]
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "0d107619-d1ad-4983-8f81-a9c6500ba137"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/85f11f8a-34e4-4d66-bfb5-b5edce06b2a6"
    },
    "owner": "aliattia"
  }
}