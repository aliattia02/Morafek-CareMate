GICS_URL=http://gics:8080
GICS_TIMEOUT=15

# 2026-08-12: the gICS domain itself was recreated/renamed via the admin UI
# alongside the new ENRICH policy — it is now "Morafek" (signer-ID type
# "IMI"), NOT "morafek-data-sharing" / "morafek-patient-id". Confirmed via a
# live listDomains SOAP call, not assumed — mismatching the domain name is
# what actually caused the 502s (the template/module names below were a
# second, separate mismatch on top of that).
GICS_DOMAIN=Morafek
GICS_SIGNER_ID_TYPE=IMI

# Active consent template/module/policy in gICS's admin UI — MUST match an
# actual template/module in GICS_DOMAIN exactly (name + version), or gICS
# fails closed with an unhandled 500 (see gics_service.py's module docstring).
# Set to the new "ENRICH Consent Policy" objects (2026-08-12) — update these
# whenever the active policy in gICS's admin UI changes.
# NOTE: GICS_TEMPLATE_NAME is the template's *Label* text as gICS actually
# returns it in consentTemplateKey.name (confirmed via listCurrentConsentTemplates)
# — NOT the "Key" field shown in the admin UI's edit screen. The two differ
# for this template; verify with listCurrentConsentTemplates if this ever
# stops matching again.
# 2026-08-12, later same day — v1.3 (supersedes the v1.2 attempt below):
# v1.2's module lost its assignedPolicies during duplication — addConsent/
# refuseConsent still reported success against it (neither operation
# validates a policy exists), but with no policy attached, no signedPolicy
# record was ever created, so getPolicyStatesForPolicyNameAndSignerIds
# (every status read: patient status check, accept's idempotency check,
# research sync eligibility) silently found nothing and read back UNKNOWN —
# live and broken for the whole time v1.2 was configured here. v1.3 fixes
# this with the policy explicitly re-attached, confirmed via a live
# listCurrentConsentTemplates policy-assignment check before this was wired
# in (not just checked for name/version like every prior pass).
#
# ANOTHER Label-vs-Key catch on this pass: the v1.3 module's name is now
# "Wearable Health Data Recording" (Title Case, spaces) — NOT the old
# snake_case "wearable_health_data_recording" key. Same fallback-to-Label
# behavior as before, just hit the module this time instead of a template.
GICS_TEMPLATE_NAME=Consent to Wearable Health Data Recording
GICS_TEMPLATE_VERSION=1.3
GICS_MODULE_NAME=Wearable Health Data Recording
GICS_MODULE_VERSION=1.3
GICS_POLICY_NAME=enrich_consent_policy
GICS_POLICY_VERSION=1.0

# Withdrawal (REVOCATION-type) template — used by revoke instead of the
# Consent template above, so a withdrawal files under gICS's "Withdrawals"
# section, not "Consents". Also bumped to v1.3 in the same pass, same
# module (Wearable Health Data Recording v1.3) and same policy fix as
# above — confirmed via the same live check, not assumed from the v1.2
# naming pattern.
GICS_WITHDRAWAL_TEMPLATE_NAME=Withdrawal of Consent to Wearable Health Data Recording
GICS_WITHDRAWAL_TEMPLATE_VERSION=1.3


GPAS_URL=http://gpas:8080
GPAS_DOMAIN=morafek-patients
GPAS_TIMEOUT=15
GPAS_ENABLED=true

